{
  "name": "gcoysorg",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // The Worker runs first so it can send tcffl.gcoys.org to the TCFFL pages
    // (see routeSite in src/worker.js). Pages are still plain static files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gcoys-registrations",
      // Replace with the Database ID shown in Cloudflare -> Storage & Databases -> D1 (see docs/SETUP.md, step 1).
      "database_id": "6f302414-48b4-4cbe-b4c7-1b28e8e8582b"
    }
  ]
}
